# ── WhatsApp Business Cloud API (Meta) ──────────────────────────
# Crie um app em https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
# Token inventado por você, usado no handshake do webhook (Meta → seu servidor)
WHATSAPP_VERIFY_TOKEN=

# ── Asaas (psp.provider: asaas) ─────────────────────────────────
# Sandbox: https://sandbox.asaas.com → Integrações → API Key
ASAAS_API_KEY=
# Token de autenticação do webhook (configure o MESMO valor no painel do Asaas)
ASAAS_WEBHOOK_TOKEN=

# ── Mercado Pago (psp.provider: mercadopago) ────────────────────
# https://www.mercadopago.com.br/developers → Suas integrações
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (painel → Webhooks → Assinatura secreta)
MP_WEBHOOK_SECRET=

# ── Assistente de IA (assistant.enabled: true no config.yaml) ──
# Crie em https://aistudio.google.com/apikey (tem nível gratuito)
GEMINI_API_KEY=

# ── Painéis web ─────────────────────────────────────────────────
# Token do painel do administrador (/admin?token=...). Vazio = desativado.
PIXZAP_ADMIN_TOKEN=
# Segredo dos links mágicos do vendedor (opcional: gerado sozinho se vazio)
PIXZAP_DASHBOARD_SECRET=
